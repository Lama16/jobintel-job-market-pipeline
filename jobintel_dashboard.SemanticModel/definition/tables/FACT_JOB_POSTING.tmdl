	column TITLE
		dataType: string
		lineageTag: b16cdd1e-df9f-4ef1-8b02-3d90f82c71e2
		summarizeBy: none
		sourceColumn: TITLE

		annotation SummarizationSetBy = Automatic

	column ROLE_FAMILY
		dataType: string
		lineageTag: 9e494c3b-0cd0-440d-9b1e-c29e427e5651
		summarizeBy: none
		sourceColumn: ROLE_FAMILY

		annotation SummarizationSetBy = Automatic

	column SALARY_MIN
		dataType: double
		lineageTag: 226e6c27-aea3-4f96-b318-724297f03feb
		summarizeBy: sum
		sourceColumn: SALARY_MIN

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column SALARY_MAX
		dataType: double
		lineageTag: 24e7a7c7-7637-4f8f-aaf5-472094763c11
		summarizeBy: sum
		sourceColumn: SALARY_MAX

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column IS_ESTIMATED
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 55435b70-25a1-4b9b-b5af-64b8794b8d80
		summarizeBy: none
		sourceColumn: IS_ESTIMATED

		annotation SummarizationSetBy = Automatic

	column SOURCE
		dataType: string
		lineageTag: 67bff16d-5053-417e-b582-c0391162fb70
		summarizeBy: none
		sourceColumn: SOURCE

		annotation SummarizationSetBy = Automatic

	column 'Salary Band' = VAR mid = (FACT_JOB_POSTING[SALARY_MIN] + FACT_JOB_POSTING[SALARY_MAX]) / 2 RETURN SWITCH(TRUE(), mid < 20000, "0. Hourly or invalid", mid < 75000, "1. Under $75K", mid < 100000, "2. $75K-$100K", mid < 125000, "3. $100K-$125K", mid < 150000, "4. $125K-$150K", mid < 200000, "5. $150K-$200K", "6. $200K and above")
		dataType: string
		lineageTag: 0b1d6f3e-5a7c-4c1e-9f2a-1a0000000009
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition FACT_JOB_POSTING = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases("HWAMCFE-BN02620.snowflakecomputing.com","JOBINTEL_WH",[Implementation="2.0"]),
				    JOBINTEL_Database = Source{[Name="JOBINTEL",Kind="Database"]}[Data],
				    MARKET_Schema = JOBINTEL_Database{[Name="MARKET",Kind="Schema"]}[Data],
				    FACT_JOB_POSTING_Table = MARKET_Schema{[Name="FACT_JOB_POSTING",Kind="Table"]}[Data]
				in
				    FACT_JOB_POSTING_Table

	annotation PBI_ResultType = Table

