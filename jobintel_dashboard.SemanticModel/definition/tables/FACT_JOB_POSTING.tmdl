table FACT_JOB_POSTING
	lineageTag: ac3cf42d-5c34-4797-b3be-42b230d08882

	measure 'Total Jobs' = COUNTROWS(FACT_JOB_POSTING)
		formatString: 0
		lineageTag: 2d440547-5fcf-4ce8-ab82-9c72aca7a750

	measure 'Avg Salary Published' =
			
			CALCULATE(
			    AVERAGEX(FACT_JOB_POSTING, (FACT_JOB_POSTING[SALARY_MIN] + FACT_JOB_POSTING[SALARY_MAX]) / 2),
			    FACT_JOB_POSTING[IS_ESTIMATED] = FALSE()
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 7be7c28d-3ecc-48cd-ab64-69433cce7e6f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Salary Estimated' =
			
			CALCULATE(
			    AVERAGEX(FACT_JOB_POSTING, (FACT_JOB_POSTING[SALARY_MIN] + FACT_JOB_POSTING[SALARY_MAX]) / 2),
			    FACT_JOB_POSTING[IS_ESTIMATED] = TRUE()
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: c9d93c5f-55fa-48f8-9ca9-0367cabe1a54

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '% Estimated' = DIVIDE(CALCULATE([Total Jobs], FACT_JOB_POSTING[IS_ESTIMATED] = TRUE()), [Total Jobs])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 42ffbda5-b7a0-4b52-81c8-36f3b22dc130

	measure 'Skill Mentions' = COUNTROWS(BRIDGE_JOB_SKILL)
		formatString: 0
		lineageTag: e3b273f9-4947-40f5-80b2-ecd75604364e

	measure 'Jobs Without Role Family' = CALCULATE([Total Jobs], ISBLANK(FACT_JOB_POSTING[ROLE_FAMILY]))
		formatString: 0
		lineageTag: 6ea8c11a-af2d-46d2-bdd4-ca1233dfbb8b

	measure 'Published Jobs' = CALCULATE([Total Jobs], FACT_JOB_POSTING[IS_ESTIMATED] = FALSE())
		formatString: 0
		lineageTag: 0b1d6f3e-5a7c-4c1e-9f2a-1a0000000001

	measure 'Estimated Jobs' = CALCULATE([Total Jobs], FACT_JOB_POSTING[IS_ESTIMATED] = TRUE())
		formatString: 0
		lineageTag: 0b1d6f3e-5a7c-4c1e-9f2a-1a0000000002

	measure 'Median Salary Published' = CALCULATE(MEDIANX(FACT_JOB_POSTING, (FACT_JOB_POSTING[SALARY_MIN] + FACT_JOB_POSTING[SALARY_MAX]) / 2), FACT_JOB_POSTING[IS_ESTIMATED] = FALSE())
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 0b1d6f3e-5a7c-4c1e-9f2a-1a0000000003

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Median Salary Estimated' = CALCULATE(MEDIANX(FACT_JOB_POSTING, (FACT_JOB_POSTING[SALARY_MIN] + FACT_JOB_POSTING[SALARY_MAX]) / 2), FACT_JOB_POSTING[IS_ESTIMATED] = TRUE())
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 0b1d6f3e-5a7c-4c1e-9f2a-1a0000000004

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Min Salary Published' = CALCULATE(AVERAGE(FACT_JOB_POSTING[SALARY_MIN]), FACT_JOB_POSTING[IS_ESTIMATED] = FALSE())
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 0b1d6f3e-5a7c-4c1e-9f2a-1a0000000005

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Max Salary Published' = CALCULATE(AVERAGE(FACT_JOB_POSTING[SALARY_MAX]), FACT_JOB_POSTING[IS_ESTIMATED] = FALSE())
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 0b1d6f3e-5a7c-4c1e-9f2a-1a0000000006

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Jobs With Skills' = DISTINCTCOUNT(BRIDGE_JOB_SKILL[JOB_ID])
		formatString: 0
		lineageTag: 0b1d6f3e-5a7c-4c1e-9f2a-1a0000000007

	measure '% Jobs With Skills' = DIVIDE([Jobs With Skills], [Total Jobs])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0b1d6f3e-5a7c-4c1e-9f2a-1a0000000008

	column JOB_ID
